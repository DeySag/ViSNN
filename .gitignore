# Datasets and generated artifacts
datasets/
checkpoints/
# Run artifacts: figures/logs stay local, but run summaries (json/csv) are
# tracked so experiment records survive session churn. The re-include dance
# works because results/** excludes directories too; !results/**/ un-excludes
# the directories themselves, then json/csv files are re-included explicitly.
results/**
!results/**/
!results/**/*.json
!results/**/*.csv
!results/**/*.md
*.npz
*.pt
*.pth

# KITTI index cache written next to the data
.visnn_index.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
.ipynb_checkpoints/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
